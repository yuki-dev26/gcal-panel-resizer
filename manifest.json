{
  "manifest_version": 3,
  "name": "GCal Panel Resizer",
  "version": "1.0.0",
  "description": "Google カレンダーの右サイドパネル（ToDo、Keep、Maps など）の幅をドラッグで変更できます。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "GCal Panel Resizer"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/calendar/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://tasks.google.com/*",
        "https://keep.google.com/*",
        "https://contacts.google.com/*"
      ],
      "js": [
        "frame.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}